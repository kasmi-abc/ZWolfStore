# Database - Neon PostgreSQL (production)
DATABASE_URL="postgresql://neondb_owner:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Admin credentials (seeded in DB + fallback env)
ADMIN_USER="username1234"
ADMIN_PASS_HASH="$2b$10$... (bcrypt hash of password)"
# Auth - 32+ chars random secret for JWT (jose HS256)
AUTH_SECRET="change-me-32chars-random-base64url"
NEXTAUTH_SECRET="change-me-32chars-random-base64url"
NEXTAUTH_URL="http://localhost:3000"
# Optional: Vercel URL
# VERCEL_URL=""
